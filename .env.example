# ─────────────────────────────────────────────────────────────────────────────
# VELTRON website — environment variables
# Copy to `.env` for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (exposed to the browser, VITE_ prefix) ───────────────────────────
# Canonical site origin, no trailing slash. Optional on Vercel (falls back to
# the production domain) — set it once the custom domain is live.
VITE_SITE_URL=https://www.example.com

# Cloudflare Turnstile *site* key (https://dash.cloudflare.com → Turnstile).
# Local dev falls back to Cloudflare's always-pass test key when empty.
VITE_TURNSTILE_SITE_KEY=

# ── Server-only (Vercel Functions in /api) ──────────────────────────────────
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Business inbox that receives website inquiries (comma-separate for several)
CONTACT_TO_EMAIL=sales@example.com

# Verified sender on your Resend domain
CONTACT_FROM_EMAIL="VELTRON Website <website@example.com>"

# Cloudflare Turnstile *secret* key.
# Test secret that always passes (dev only): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Send a localized confirmation email to the visitor (true/false)
CONTACT_AUTOREPLY=true

# Optional: extra allowed origins for the API, comma-separated (e.g. preview domains)
ALLOWED_ORIGINS=

# Optional but recommended in production: global rate limiting via Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
